{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "AWS_PROFILE": "tj-readonly"
  },
  "permissions": {
    "allow": [
      "Bash(pnpm *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "deny": [
      "Bash(*cdk destroy*)",
      "Bash(*cdk deploy*)",
      "Bash(*tj-admin*)",
      "Bash(git push --force*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && jq -r '.tool_input.file_path' | xargs -I{} pnpm exec prettier --write --ignore-unknown \"{}\""
          }
        ]
      }
    ]
  }
}
